{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "product-image-review-platform",
  "identifier": "com.product-image-review-platform.dev",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    },
    "windows": [
      {
        "title": "Product Image Review Platform",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "label": "main"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
